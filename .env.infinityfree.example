# InfinityFree production environment template for EduSync MU
# Copy this file to ".env" on your local machine before creating the final zip.

# Database Configuration (use exact values from InfinityFree -> MySQL Databases)
DB_HOST=sqlXXX.infinityfree.com
DB_NAME=if0_XXXXXXXX_edusync_mu
DB_USER=if0_XXXXXXXX
DB_PASS=CHANGE_ME
DB_CHARSET=utf8mb4

# AI Configuration (optional)
GROQ_API_KEY=
GEMINI_API_KEY=
